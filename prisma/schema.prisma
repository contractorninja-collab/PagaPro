  filtersJson Json @map("filters_json")

  generatedByUserId String? @map("generated_by")
  generatedBy       User?   @relation("GeneratedReportAuthor", fields: [generatedByUserId], references: [id], onDelete: SetNull)

  generatedAt DateTime @default(now()) @map("generated_at")

  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  rowCount         Int?
  previewTruncated Boolean @default(false)

  filterPayrollId    String? @map("filter_payroll_id")
  filterYear         Int?    @map("filter_year")
  filterMonth        Int?    @map("filter_month")
  filterDepartmentId String? @map("filter_department_id")
  filterEmployeeId   String? @map("filter_employee_id")

  exportLogs ReportExportLog[]

  @@index([companyId])
  @@index([companyId, reportType])
  @@index([companyId, generatedAt])
  @@index([fileFormat])
  @@index([companyId, isArchived])
  @@index([companyId, filterPayrollId])
  @@index([companyId, filterYear, filterMonth])
  @@map("generated_reports")
}

model ReportExportLog {
  id String @id @default(cuid())

  companyId String @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  generatedReportId String @map("generated_report_id")
  generatedReport   GeneratedReport @relation(fields: [generatedReportId], references: [id], onDelete: Cascade)

  action ReportExportAction

  performedByUserId String? @map("performed_by")
  performedBy       User?   @relation("ReportExportLogActor", fields: [performedByUserId], references: [id], onDelete: SetNull)

  performedAt DateTime @default(now()) @map("performed_at")

  metadataJson Json? @map("metadata_json")

  @@index([companyId])
  @@index([companyId, generatedReportId, performedAt])
  @@map("report_export_logs")
}

// -----------------------------------------------------------------------------
// Employee timeline & notifications (operational visibility)
// -----------------------------------------------------------------------------

model EmployeeTimelineEvent {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())

  /// Stable code e.g. CONTRACT_GENERATED, LEAVE_APPROVED, PAYROLL_LOCKED
  eventType String

  severity TimelineEventSeverity?

  subjectKind String?
  subjectId   String?

  title String
  body  String? @db.Text

  metadata Json?

  actorUserId String?
  actor       User? @relation("TimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  actorMembershipId String?
  actorMembership   UserCompanyMembership? @relation("TimelineActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, employeeId, occurredAt(sort: Desc)])
  @@index([companyId, eventType, occurredAt])
  @@map("employee_timeline_events")
}

model NotificationOutbox {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  targetUserId String?
  targetUser   User?   @relation("NotificationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  channel NotificationChannel
  topic   NotificationTopic

  payload Json

  scheduledFor DateTime
  processedAt  DateTime?

  attempts  Int    @default(0)
  lastError String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, topic, scheduledFor])
  @@map("notification_outbox")
}

model NotificationPreference {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  channels      Json?
  mutedTopics   Json?
  digestFrequency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("notification_preferences")
}

/// HR-readable activity feed (diff-sized payloads); pair with AuditLog for technical CRUD trails.
model DomainActivity {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String

  verb DomainActivityVerb

  actorUserId String?
  actor       User?   @relation("DomainActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())

  summary String
  payload Json?

  @@index([companyId, occurredAt])
  @@index([entityType, entityId])
  @@map("domain_activities")
}

// -----------------------------------------------------------------------------
// Audit log (entity mutations — complement Prisma timestamps)
// -----------------------------------------------------------------------------

model AuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  companyId String?

  entityType String // e.g. Payroll, PayrollEntry
  entityId   String

  action String
  /// CREATE, UPDATE, DELETE, LOCK, UNLOCK, APPROVE, REJECT — align with application constants.

  diff Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Employee documents — the uploaded half of the personnel file ("dosja")
// -----------------------------------------------------------------------------

/// HR folder taxonomy for uploaded employee files. Generated documents keep
/// their own DocumentCategory; these are the papers a company COLLECTS.
enum EmployeeDocumentCategory {
  IDENTIFIKIM // letërnjoftim, pasaportë, leje qëndrimi, leje pune
  KONTRATA_TE_NENSHKRUARA // scans of signed contracts and annexes
  KUALIFIKIME // diploma, certifikata, licenca
  MJEKESORE // sensitive — gated by documents.sensitive
  DISIPLINORE // sensitive — gated by documents.sensitive
  DEKLARATA_PELQIME // GDPR/LMDhP pëlqime, deklarata të brendshme
  TJERA
}

model EmployeeDocument {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  category EmployeeDocumentCategory
  title    String
  note     String? @db.Text

  /// Sanitized original filename, for display and Content-Disposition only.
  /// The storage key never contains user input.
  displayFilename String

  /// companies/{companyId}/employees/{employeeId}/documents/{uuid}.{ext} —
  /// the prefix assertCompanyScopedStorageKey() guards.
  storageKey  String @unique
  contentType String
  sizeBytes   Int
  sha256      String

  issuedAt  DateTime?
  /// Non-null makes the document part of the 60-day expiry alert sweep.
  expiresAt DateTime?

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  supersedesId String?
  supersedes   EmployeeDocument?  @relation("EmployeeDocumentSupersedesChain", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy EmployeeDocument[] @relation("EmployeeDocumentSupersedesChain")

  uploadedByUserId String?
  uploadedBy       User?   @relation("EmployeeDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, employeeId, isArchived, category])
  @@index([companyId, expiresAt])
  @@index([companyId, createdAt])
  @@index([supersedesId])
  @@map("employee_documents")
}
