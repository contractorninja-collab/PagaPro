// PagaPRO — PostgreSQL schema (Kosovo payroll–oriented, multi-company ready)
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum CurrencyCode {
  EUR // Kosovo operational reality + accounting norm
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum JobTitleStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum CompanyMembershipRole {
  OWNER
  ADMIN
  HR_MANAGER
  ACCOUNTANT
  READ_ONLY
}

enum EmploymentType {
  EMPLOYEE // subject to Kosovo withholding + pension per parameter set
  CONTRACTOR // gross-out; PIT & pension amounts expected to be 0 at entry level
}

enum EmployerPrimacy {
  PRIMARY // progressive ATK brackets (punëdhënës kryesor)
  SECONDARY // flat withholding at source for chosen secondary employer (ATK 10% default)
}

enum SecondaryEmployerPitBase {
  TAXABLE_AFTER_PENSION
  GROSS
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE /// Jo aktiv — nuk është larguar zyrtarisht
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

/// Append-only employment events for HR history & audits (complements EmploymentPeriod segments).
enum EmployeeHistoryEventKind {
  CREATED
  UPDATED
  STATUS_CHANGED
  ARCHIVED
  TERMINATED
}

enum PayrollPeriodStatus {
  DRAFT
  REVIEWED // në shqyrtim — pa ndryshime
  APPROVED // i miratuar për kyçje
  LOCKED // immutable — entries të ngrira
  ARCHIVED // arkiv historik pas kyçjes
}

enum CompensationBasis {
  GROSS_MONTHLY
  TARGET_NET_MONTHLY
  /// Paga bruto e dhënë si €/orë (punëtorë fabrike etj.) — spreadsheet-i përdor
  /// Employee.hourlyRate direkt në vend që ta nxjerrë normën nga paga mujore.
  HOURLY_GROSS
}

enum ContractorPayrollStatus {
  DRAFT
  LOCKED
  ARCHIVED
}

enum ContractorHoursSource {
  /// Hours typed in by HR — the default.
  MANUAL
  /// Hours pre-filled from aggregated time-clock days; still editable afterwards.
  TIMECLOCK
}

/// How a contractor's pay is agreed. Both are net — contractors carry no
/// withholding — so the figure entered is the figure paid.
enum ContractorPayBasis {
  /// Orë × tarifë (+ premium). Hours drive the pay.
  HOURLY
  /// A fixed amount per month, independent of hours worked.
  MONTHLY_FLAT
}

/// Kosovo Labour Law (Ligji Nr. 03/L-212, Neni 10) contract-duration categories.
enum ContractTermType {
  INDEFINITE
  FIXED_TERM
  SPECIFIC_TASK
}

enum PayrollCorrectionKind {
  NET_ADJUSTMENT
  GROSS_ADJUSTMENT
  TAX_ADJUSTMENT
  PENSION_ADJUSTMENT
  OTHER
}

enum PayrollAdjustmentKind {
  BONUS
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum PayrollDocumentKind {
  REGISTER_WITH_TOTALS
  REGISTER_SIGNATURE_LIST
  EMPLOYEE_PAYSLIP
  PAYSLIPS_PRINT_BUNDLE
}

enum PayrollEntryStatus {
  DRAFT
  FINAL
}

enum PayslipDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum LeaveType {
  PUSHIM_VJETOR
  PUSHIM_MJEKESOR
  PUSHIM_PERSONAL
  PUSHIM_PA_PAGESE
  PUSHIM_LEHONIE
  TJETER
}

/// Kosovo Law 03/L-212 operational sub-types (Art 39 paid events, Art 50 paternity phases, maternity phase labels for payroll hooks).
enum LeaveSubtype {
  NONE
  MARTESE
  VDEKJE_FAMILJARE
  LINDJE_FEMIJE
  DHURIM_GJAKU
  ATERSI_PAGUAR_2_DITE
  ATERSI_PA_PAGESE_JAVE_2
  LEHONI_FAZA_PUNEDHENESI_70
  LEHONI_FAZA_QEVERIA_50
  LEHONI_FAZA_FUNDIT_PA_PAGESE
  /// Lëndim në punë / sëmundje profesionale — jashtë kuotës 20-ditore të pushimit mjekësor të rregullt.
  LENDIM_PUNE_OSE_SEMUNDJE_PROFESIONALE
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AnnualLeaveAccrualMode {
  UPFRONT
  MONTHLY
  STATUTORY_FIRST_YEAR
}

enum AnnualLeaveRoundingMode {
  NONE
  HALF_DAY
  FULL_DAY
}

enum ContractKind {
  EMPLOYMENT
  CONTRACTOR_AGREEMENT
  AMENDMENT
}

/// Universal document family for templates + generation artifacts
enum DocumentCategory {
  CONTRACT
  LEAVE
  TERMINATION
  WARNING
  PAYROLL
  OTHER
}

/// Polymorphic subject pointer (mirrors DocumentCategory)
enum DocumentSubjectKind {
  CONTRACT
  LEAVE
  TERMINATION
  WARNING
  PAYROLL
  OTHER
}

/// Only meaningful when DocumentTemplate.documentCategory = CONTRACT
enum DocumentTemplateSubtype {
  AFAT_I_CAKTUAR // fixed-term
  AFAT_I_PACAKTUAR // open-ended / indefinite
  KONTRATE_SPECIFIKE // specific / special-purpose agreement
  PRAKTIKANT // internship contract (Neni 16), part-time, always fixed-term
}

enum DocumentSourceFormat {
  DOCX
  HTML_LEGACY // historic bodyHtml column
  PDF // reserved — generation pipeline not implemented yet
}

enum TemplateDetectionMode {
  PLACEHOLDER
  BLANK_FIELDS
  MIXED
}

enum DocumentGenerationStatus {
  PENDING
  RENDERING
  SUCCEEDED
  FAILED
}

enum DocumentGenerationArtifactKind {
  PREVIEW
  ARCHIVED_FINAL
}

enum DisciplinaryWarningStatus {
  DRAFT
  ISSUED
  VOID
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUPERSEDED
  TERMINATED
}

enum TerminationType {
  LARGIM_VULLNETAR
  PA_PARALAJMERIM
  MARREVESHJE_E_DYANSHME
  NGA_PUNEDHENESI
  MANUAL
}

enum TerminationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  COMPLETED
  CANCELLED
}

enum ReportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ReportOutputFormat {
  PDF
  XLSX
  CSV
}

/// Raportet module — catalogued operational exports (stable keys for filters_json validation).
enum ReportType {
  LISTA_PUNONJESVE
  PUNONJES_AKTIVE
  PUNONJES_TE_LARGUAR
  KONTRAKTORE
  PUNONJES_SIPAS_DEPARTAMENTIT
  PUNONJES_ME_DOKUMENTE_QE_MUNGOJNE
  RAPORT_PAGAVE_MUJORE
  LISTA_PAGAVE_ME_SUMA
  LISTA_PER_NENSHKRIM_PA_SUMA
  FINANCE_PAYROLL_WORKBOOK
  ATK_EXPORT_WORKBOOK
  TRUSTI_DHE_TATIMI
  EMPLOYER_TOTAL_COST
  SALARY_ADVANCE_DEDUCTIONS
  PUSHIMET_SIPAS_PUNONJESIT
  PUSHIMET_VJETORE_TE_SHFRYTEZUARA
  PUSHIMET_NE_PRITJE
  PUSHIMET_MJEKESORE
  PUSHIMET_PA_PAGESE
  BALANCA_E_PUSHIMEVE
  CARRY_OVER_LEAVE
  DOKUMENTET_E_GJENERUARA
  KONTRATA_AKTIVE
  KONTRATA_AFER_SKADIMIT
  DOKUMENTET_SIPAS_PUNONJESIT
  TEMPLATES_TE_PERDORURA
  LARGIMET_SIPAS_MUAJIT
  LARGIMET_SIPAS_ARSYEVE
  FINAL_PAYROLL_REPORTS
  DOKUMENTET_E_LARGIMIT
}

enum ReportExportAction {
  GENERATED
  DOWNLOADED
  REGENERATED
  ARCHIVED
  PREVIEWED
}

enum WorkArrangement {
  ON_SITE
  REMOTE
  HYBRID
}

enum EmploymentPeriodReason {
  HIRE
  REHIRE
  TERMINATION
  CORRECTION
}

enum TimelineEventSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Payroll calendar — how the holiday was introduced (HR-visible).
enum CompanyHolidayCategory {
  KOSOVO_OFFICIAL_FIXED
  KOSOVO_OFFICIAL_MOVABLE
  COMPANY_CUSTOM
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
}

enum NotificationTopic {
  CONTRACT_EXPIRING
  PAYROLL_REMINDER
  LEAVE_PENDING
  SYSTEM_ALERT
}

/// Domain-level verbs for HR-readable activity rows (complements AuditLog technical actions).
enum DomainActivityVerb {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  LOCKED
  UNLOCKED
  ARCHIVED
  VOIDED
}

// -----------------------------------------------------------------------------
// Companies & settings
// -----------------------------------------------------------------------------

model Company {
  id        String @id @default(cuid())
  legalName String
  tradeName String?
  slug      String? @unique @db.VarChar(80)
  customDomain String? @unique @db.VarChar(255)


  fiscalNumber String? @unique // taxpayer / fiscal reference where applicable (NUI)
  status       CompanyStatus   @default(ACTIVE)

  /// Optional brand grouping for customers who run several legal entities — each with its
  /// own NUI — under one commercial brand. Purely an admin-console organising layer:
  /// it does NOT widen the tenant boundary. Every query stays scoped to a single companyId,
  /// and access still comes from UserCompanyMembership, one row per company.
  brandGroupId String?
  brandGroup   CompanyBrandGroup? @relation(fields: [brandGroupId], references: [id], onDelete: SetNull)

  defaultCurrency CurrencyCode @default(EUR)
  timezone        String       @default("Europe/Belgrade")

  /// Entitlement for the badge time-clock module (kiosk + attendance → payroll hours).
  /// Admin-console controlled: it lives here rather than on CompanyConfiguration, which
  /// clients rewrite wholesale from Konfigurime.
  timeClockEnabled Boolean @default(false)

  /// Entitlement for the separate hourly contractor payroll flow (Pagat → Kontraktor).
  /// Admin-console controlled, same reasoning as timeClockEnabled.
  contractorPayrollEnabled Boolean @default(false)

  /// Platform billing (admin-console only — tenants never see these).
  billingPlanId String?
  billingPlan   BillingPlan? @relation(fields: [billingPlanId], references: [id], onDelete: SetNull)
  billingCycle  BillingCycle @default(MONTHLY)
  /// Negotiated price for the chosen cycle; when set it replaces the plan's price.
  billingPriceOverrideEur Decimal? @db.Decimal(10, 2)
  billingPaid      Boolean   @default(false)
  billingPaidUntil DateTime?
  /// Kur fillon abonimi (data e kontratës / pas muajit falas).
  billingStartDate DateTime?
  /// Kur mbaron abonimi — bosh = pa afat, rinovohet sipas ciklit.
  billingEndDate   DateTime?
  /// Ditë tolerance pas skadimit të pagesës para se klienti të shënohet vonesë.
  billingGraceDays Int       @default(7)
  billingNotes     String?

  /// Registered / legal profile contact (distinct from letterhead line in CompanySetting)
  email     String?
  phone     String?
  website   String?
  addressLine String?
  city        String?
  postalCode  String?
  country     String? @default("XK")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings             CompanySetting?
  memberships          UserCompanyMembership[]
  departments          Department[]
  jobTitles            JobTitle[]
  employees            Employee[]
  payrolls             Payroll[]
  payrollParameterSets PayrollParameterSet[]
  documentTemplates    DocumentTemplate[]
  contracts            Contract[]
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]
  terminations         Termination[]
  disciplinaryWarnings DisciplinaryWarning[]
  timeClockDevices     TimeClockDevice[]
  timeClockPunches     TimeClockPunch[]
  timeClockDays        TimeClockDay[]
  contractorPayrollPeriods ContractorPayrollPeriod[]
  reportDefinitions    ReportDefinition[]
  reportJobs           ReportJob[]
  employeeTimelineEvents EmployeeTimelineEvent[]
  domainActivities       DomainActivity[]
  notificationOutboxes NotificationOutbox[]
  notificationPreferences NotificationPreference[]
  employmentPeriods      EmploymentPeriod[]
  employeeEmploymentHistories EmployeeEmploymentHistory[]
  employeeSalaryChanges  EmployeeSalaryChange[]
  employeeContractAnnexes EmployeeContractAnnex[]

  configuration           CompanyConfiguration?
  authorizedRepresentatives AuthorizedRepresentative[]
  payrollSettings         PayrollSettings?
  companyHolidays         CompanyHoliday[]
  payrollSnapshots        PayrollSnapshot[]
  payrollGeneratedDocs    PayrollGeneratedDocument[]
  payrollCorrections      PayrollCorrection[]
  documentGenerationArtifacts DocumentGenerationArtifact[]
  documentTimelineEvents      DocumentTimelineEvent[]
  employeeDocuments           EmployeeDocument[]
  leavePolicyParameterSets    LeavePolicyParameterSet[]
  leaveAccrualLedgerEntries   LeaveAccrualLedger[]
  payrollAtkExports           PayrollATKExport[]
  generatedReports            GeneratedReport[]
  reportExportLogs            ReportExportLog[]

  @@index([status])
  @@index([brandGroupId])
  @@map("companies")
}

/// A commercial brand that owns several legal entities (one Company per NUI).
///
/// Deliberately thin: it groups companies for the admin console and for "add this user to
/// every company in the group" — it holds no operational data of its own, and nothing in
/// the app resolves data through it. The tenant root is still Company.
model CompanyBrandGroup {
  id   String @id @default(cuid())
  name String

  /// Manual group discount, applied once to the group's summed billing total.
  /// Either a percentage or a fixed € amount (or both); admin-console only.
  discountPercent   Decimal? @db.Decimal(5, 2)
  discountAmountEur Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]

  @@map("company_brand_groups")
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

/// Platform billing catalog (Paketat) — admin-console only, invisible to tenants.
/// A company points at one plan and picks a cycle; a negotiated deal overrides the price.
model BillingPlan {
  id   String @id @default(cuid())
  name String @unique

  monthlyPriceEur Decimal @db.Decimal(10, 2)
  annualPriceEur  Decimal @db.Decimal(10, 2)

  /// Soft cap shown next to the live active-employee count — never blocks the client.
  maxActiveEmployees Int?

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]

  @@map("billing_plans")
}

/// Company-wide operational defaults consumed by payroll, documents, and leave flows (tenant-isolated).
model CompanyConfiguration {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Reference minimum wage — payroll validation should prefer active PayrollParameterSet; this is the configured company default.
  minimumSalaryCurrent Decimal? @db.Decimal(14, 2)

  /// Planned / announced minimum from 1 July (or next legal effective date) — used for projections and reminders.
  minimumSalaryFromJuly1 Decimal? @db.Decimal(14, 2)

  /// Total pension / “trust” contribution rate as percent (e.g. 10.0000 = 10%). Engine may split employee/employer from legislation.
  trustContributionPercent Decimal? @db.Decimal(8, 4)

  standardWeeklyHours Decimal? @db.Decimal(6, 2)

  contractReferencePrefix String? @db.VarChar(48)
  payrollPdfPrefix        String? @db.VarChar(48)
  generalDocumentPrefix String? @db.VarChar(48)

  annualLeaveDaysDefault   Decimal? @db.Decimal(6, 2)
  personalLeaveDaysDefault Decimal? @db.Decimal(6, 2)
  /// Ditë pune pushim mjekësor i rregullt në vit kalendarik (parazgjedhje aplikacioni: 20).
  medicalLeaveDaysDefault  Decimal? @db.Decimal(6, 2)
  medicalLeavePolicyNote   String?  @db.Text

  /// Ditë pune javore të kompanisë — baza e kuotës vjetore = workingDaysPerWeek × 4 (parazgjedhje 5 → 20 ditë).
  workingDaysPerWeek Decimal? @db.Decimal(4, 2)
  annualLeaveAccrualMode     AnnualLeaveAccrualMode     @default(MONTHLY)
  annualLeaveRoundingMode    AnnualLeaveRoundingMode    @default(NONE)
  allowNegativeAnnualLeaveBalance Boolean @default(false)

  /// Company-level switches — notification worker filters on these before enqueueing.
  notifyContractExpiring Boolean @default(true)
  notifyPayrollReminders Boolean @default(true)
  notifyLeaveApprovals   Boolean @default(true)
  notifyEmployeeWarnings Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_configurations")
}

/// Legal representatives for signatures / stamps — extensible for multiple signatories per company.
model AuthorizedRepresentative {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  /// Optional link to the employee this representative maps to; job title is sourced from the employee.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  fullName String
  position String?

  signatureStorageKey String?
  stampStorageKey     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, sortOrder])
  @@index([employeeId])
  @@map("authorized_representatives")
}

model CompanySetting {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Minimum gross monthly salary enforced in app against active LegalParameterSet (stored here as cache optional)
  enforceMinimumSalary Boolean @default(true)

  /// Snapshot preference: payroll uses parameter set effective on period end date
  payrollUseParameterEffectiveOn String @default("PERIOD_END") // PERIOD_END | PERIOD_START

  /// Authorized signatory for contracts ({{authorized_person}})
  authorizedRepresentativeName     String?
  /// Job title / role ({{authorized_position}})
  authorizedRepresentativePosition String?
  /// Future: PNG scan of signature in object storage
  authorizedSignatureStorageKey    String?

  /// Future: stamp image in object storage (company seal)
  authorizedStampStorageKey String?

  /// Tenant-owned logo embedded in newly generated company documents
  companyLogoStorageKey String?

  /// Registered address line(s) for contracts / letters (letterhead; Company.addressLine is legal registry block)
  companyAddressLine String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// -----------------------------------------------------------------------------
// Users & multi-company membership (RBAC anchor)
// -----------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  emailVerifiedAt DateTime?
  status       UserStatus @default(INVITED)

  displayName String?
  locale      String      @default("sq")

  /// bcrypt hash; null until the account is provisioned with credentials
  passwordHash       String?
  /// Platform-level super admin (backstage console) — not a per-company role
  isPlatformAdmin    Boolean   @default(false)
  /// Force password rotation on next login (temp passwords issued by admins)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  memberships       UserCompanyMembership[]
  linkedEmployees   Employee[]
  timeClockDevicesCreated TimeClockDevice[] @relation("TimeClockDeviceCreatedBy")
  timeClockPunchesCreated TimeClockPunch[]  @relation("TimeClockPunchCreatedBy")
  timeClockPunchesVoided  TimeClockPunch[]  @relation("TimeClockPunchVoidedBy")
  createdPayrolls   Payroll[]               @relation("PayrollCreatedBy")
  lockedPayrolls    Payroll[]               @relation("PayrollLockedBy")
  reviewedPayrolls  Payroll[]               @relation("PayrollReviewedBy")
  approvedPayrolls  Payroll[]               @relation("PayrollApprovedBy")
  archivedPayrolls  Payroll[]               @relation("PayrollArchivedBy")
  createdContractorPayrolls ContractorPayrollPeriod[] @relation("ContractorPayrollCreatedBy")
  lockedContractorPayrolls  ContractorPayrollPeriod[] @relation("ContractorPayrollLockedBy")
  payrollCorrectionsCreated PayrollCorrection[] @relation("PayrollCorrectionCreatedBy")
  payrollSnapshotsCaptured PayrollSnapshot[] @relation("PayrollSnapshotCapturedBy")
  payrollDocumentsGenerated PayrollGeneratedDocument[] @relation("PayrollDocumentGeneratedBy")
  payrollAtkExportsGenerated PayrollATKExport[]       @relation("PayrollAtkExportGeneratedBy")
  auditActors       AuditLog[]              @relation("AuditActor")
  documentTemplateVersionsUploaded DocumentTemplateVersion[] @relation("DocumentTemplateVersionUploadedBy")
  documentArtifactsCreated DocumentGenerationArtifact[] @relation("DocumentArtifactCreatedBy")
  documentTimelineEventsCreated DocumentTimelineEvent[] @relation("DocumentTimelineCreatedBy")
  employeeDocumentsUploaded EmployeeDocument[] @relation("EmployeeDocumentUploadedBy")
  timelineActorEvents     EmployeeTimelineEvent[]       @relation("TimelineActor")
  salaryChangesMade       EmployeeSalaryChange[]        @relation("SalaryChangeBy")
  contractAnnexesCreated  EmployeeContractAnnex[]       @relation("ContractAnnexBy")
  domainActivitiesAuthored DomainActivity[]              @relation("DomainActivityActor")
  notificationPreferences NotificationPreference[]
  targetedNotifications   NotificationOutbox[]          @relation("NotificationTarget")
  leaveRequestsCreated       LeaveRequest[]             @relation("LeaveCreatedBy")
  terminationsApproved       Termination[]              @relation("TerminationApprovedBy")
  terminationsCreated        Termination[]              @relation("TerminationCreatedBy")
  generatedReports           GeneratedReport[]          @relation("GeneratedReportAuthor")
  reportExportLogsPerformed  ReportExportLog[]         @relation("ReportExportLogActor")

  @@index([status])
  @@map("users")
}

/// Server-side login sessions — cookie stores the raw token, DB stores its sha256 hash.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Login attempts, kept briefly to throttle credential stuffing. No relation to
/// User on purpose — attempts against addresses that do not exist must be
/// recorded and counted exactly like attempts against ones that do.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(320)
  ip        String?  @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("login_attempts")
}

model UserCompanyMembership {
  id String @id @default(cuid())

  userId    String
  companyId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role CompanyMembershipRole

  isActive  Boolean   @default(true)
  invitedAt DateTime?
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequestsDecided LeaveRequest[] @relation("LeaveDecidedBy")
  timelineActorMembershipEvents EmployeeTimelineEvent[] @relation("TimelineActorMembership")

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("user_company_memberships")
}

// -----------------------------------------------------------------------------
// Org structure & employees
// -----------------------------------------------------------------------------

model Department {
  id   String @id @default(cuid())
  name String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  employmentHistoryRecords EmployeeEmploymentHistory[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model JobTitle {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title String
  department String?
  level String?

  description      String @db.Text
  responsibilities String? @db.Text
  requirements     String? @db.Text

  status JobTitleStatus @default(ACTIVE)

  createdByUserId String?
  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([companyId, title])
  @@index([companyId, status, title])
  @@map("job_titles")
}

model Employee {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  jobTitleId String?
  jobTitleProfile JobTitle? @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)

  /// Optional link if employee signs in to a future portal
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  employmentType EmploymentType
  status         EmploymentStatus @default(ACTIVE)

  workArrangement WorkArrangement @default(ON_SITE)

  employerPrimacy EmployerPrimacy @default(PRIMARY)

  /// Optional hourly contract fields—when set, engine can validate hourly vs monthly minimum
  hourlyRate           Decimal? @db.Decimal(14, 4)
  standardMonthlyHours Decimal? @db.Decimal(8, 2)

  firstName  String
  lastName   String
  /// Numri personal — unique brenda kompanisë
  personalId String

  dateOfBirth DateTime?
  gender      Gender?

  phone String?
  email String?

  hireDate           DateTime
  terminationDate    DateTime?
  terminationReason  String? @db.Text
  jobTitle           String?
  probationMonths    Int?

  /// Contract term (Ligji Nr. 03/L-212, Neni 10-11). contractStartDate defaults to hireDate;
  /// contractEndDate is null for indefinite contracts. Drives annex renewals + expiry.
  contractStartDate DateTime?
  contractEndDate   DateTime?
  contractType      ContractTermType @default(INDEFINITE)
  /// Vendi i punës (Neni 11.4); falls back to the company address when empty.
  workplace         String?
  /// Kualifikimi: schooling / professional qualification (Neni 11.1.3), printed in the contract.
  qualification     String?

  /// Badge / chip code scanned at the time clock. Unique per company when set.
  badgeCode String? @db.VarChar(64)

  /// Orët kontraktuale javore (UI default 40)
  weeklyHours Decimal @default(40) @db.Decimal(6, 2)

  /// Stored monthly gross for employees; for contractors, interpret as agreed monthly fee baseline (still validated unless exempt)
  baseSalaryMonthly Decimal @db.Decimal(14, 2)

  compensationBasis CompensationBasis @default(GROSS_MONTHLY)

  /// Target monthly net when compensationBasis = TARGET_NET_MONTHLY (engine solves gross / hourly basis from this).
  targetNetMonthly Decimal? @db.Decimal(14, 2)

  /// Contractors may bypass minimum salary checks when true
  exemptFromMinimumSalary Boolean @default(false)

  /// Parapaguesë: apliko pension/trust dhe tatimin në motorin e pagës (kontraktorët = false)
  applyTrust Boolean @default(true)
  applyTax   Boolean @default(true)

  /// Shtetas i huaj me qëndrim të përkohshëm (Ligji 04/L-101: i përjashtuar nga
  /// kontributet e detyrueshme të Trustit; tatimi në paga aplikohet normalisht).
  /// The form auto-sets applyTrust=false when this is enabled; applyTrust stays
  /// the single calculation switch so voluntary contributions remain possible.
  isForeignNational Boolean @default(false)
  /// Skadimi i lejes së qëndrimit — drives the dashboard expiry alert.
  residencePermitExpiryDate DateTime?

  /// Emri i bankës (kopjim i shpejtë për UI; llogaria kryesore në EmployeeBankAccount)
  bankName String?

  /// Legacy convenience IBAN; prefer EmployeeBankAccount for normalized history.
  bankAccountIban String?

  /// Residential / mailing address for contracts ({{employee_address}})
  addressLine    String?
  addressCity    String?
  addressCountry String? @default("XK")

  internalNotes    String? @db.Text
  documentsMissing Boolean @default(false)

  /// Kosovo leave law — hazardous roles minimum 30 working days annual (Art 32.3)
  isHazardousPosition Boolean @default(false)
  /// Art 32.4 extra leave eligibility flags (HR-maintained)
  isSingleParent       Boolean @default(false)
  hasDisability        Boolean @default(false)
  hasChildUnderThree   Boolean @default(false)
  /// Optional anchor when legal tenure ≠ hireDate (collective agreements / transfers)
  leaveTenureAnchorDate DateTime?

  /// Vite të plota përvojë pune PARA kësaj kompanie (Neni 37.2 numëron përvojën
  /// totale për ditët shtesë: +1 ditë / 5 vjet). Vetëm bonusi i përvojës e lexon —
  /// akruali dhe pragu 6-mujor mbeten të lidhur me hireDate. HR e vërteton me
  /// vërtetim përvoje / regjistrat e Trustit.
  priorWorkExperienceYears Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollEntries PayrollEntry[]
  contractorPayrollEntries ContractorPayrollEntry[]
  contracts      Contract[]
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
  terminations   Termination[]
  disciplinaryWarnings DisciplinaryWarning[]
  timeClockPunches     TimeClockPunch[]
  timeClockDays        TimeClockDay[]
  employmentPeriods    EmploymentPeriod[]
  bankAccounts         EmployeeBankAccount[]
  emergencyContacts    EmployeeEmergencyContact[]
  timelineEvents       EmployeeTimelineEvent[]
  employmentHistoryRecords EmployeeEmploymentHistory[]
  salaryChanges        EmployeeSalaryChange[]
  contractAnnexes      EmployeeContractAnnex[]
  payrollGeneratedDocs PayrollGeneratedDocument[]
  payrollInclusions    PayrollIncludedEmployee[]
  payrollCorrections   PayrollCorrection[]
  documentGenerationArtifacts DocumentGenerationArtifact[]
  documentTimelineEvents      DocumentTimelineEvent[]
  employeeDocuments           EmployeeDocument[]
  leaveAccrualLedgerEntries   LeaveAccrualLedger[]
  authorizedRepresentatives   AuthorizedRepresentative[]

  @@unique([companyId, personalId])
  @@unique([companyId, badgeCode])
  @@index([companyId, lastName, firstName])
  @@index([companyId])
  @@index([jobTitleId])
  @@index([companyId, status])
  @@index([companyId, employmentType])
  @@index([companyId, email])
  @@index([email])
  @@index([userId])
  @@map("employees")
}

/// Effective-dated compensation-change history — one row per salary/basis change (audit of raises).
model EmployeeSalaryChange {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// When the new compensation takes effect (hire date for the initial record).
  effectiveFrom DateTime

  /// Null for the initial (hire) record; otherwise the prior monthly gross.
  previousBaseSalary Decimal? @db.Decimal(14, 2)
  newBaseSalary      Decimal  @db.Decimal(14, 2)

  compensationBasis CompensationBasis @default(GROSS_MONTHLY)
  targetNetMonthly  Decimal?          @db.Decimal(14, 2)

  reason String? @db.Text

  changedById String?
  changedBy   User?   @relation("SalaryChangeBy", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, employeeId, effectiveFrom(sort: Desc)])
  @@index([companyId])
  @@map("employee_salary_changes")
}

/// Issued contract amendment (Aneks Kontratë, Ligji Nr. 03/L-212 Neni 10-11, 17-19).
/// Each row records what changed (changesJson) plus a snapshot of the Neni-11 elements at
/// issue time, so the next annex diffs against this snapshot. The DOCX is rendered on demand.
model EmployeeContractAnnex {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Sequential per employee (Aneks nr. 1, 2, …).
  annexNumber Int

  /// When the amendment takes effect.
  effectiveDate DateTime

  /// Which categories changed: e.g. ["SALARY","JOB_TITLE","HOURS","CONTRACT_TERM"].
  changeCategories String[]

  /// Array of { field, label, from, to } describing each change, as rendered in the document.
  changesJson Json

  /// Snapshot of the Neni-11 elements at issue time (the baseline the next annex diffs against).
  snapshotJobTitle        String?
  snapshotJobDescription  String? @db.Text
  snapshotDepartment      String?
  snapshotWorkplace       String?
  snapshotWeeklyHours     Decimal? @db.Decimal(6, 2)
  snapshotBaseSalary      Decimal? @db.Decimal(14, 2)
  snapshotContractStart   DateTime?
  snapshotContractEnd     DateTime?
  snapshotContractType    ContractTermType?

  createdById String?
  createdBy   User?   @relation("ContractAnnexBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([employeeId, annexNumber])
  @@index([companyId, employeeId])
  @@index([companyId])
  @@map("employee_contract_annexes")
}

/// HR employment history stream (position/status snapshots). Works alongside EmploymentPeriod legal segments.
model EmployeeEmploymentHistory {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())

  kind EmployeeHistoryEventKind

  title       String
  description String? @db.Text

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  jobTitle       String?
  employmentType EmploymentType?
  status         EmploymentStatus?

  metadata Json?

  @@index([companyId, employeeId, occurredAt(sort: Desc)])
  @@index([companyId])
  @@map("employee_employment_history")
}

/// Hire / re-hire / termination segments — authoritative employment history (use services to maintain consistency with Employee.status).
model EmploymentPeriod {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  startedAt DateTime
  endedAt   DateTime?

  reason EmploymentPeriodReason

  terminationId String?
  termination   Termination? @relation(fields: [terminationId], references: [id], onDelete: SetNull)

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, employeeId, startedAt])
  @@map("employment_periods")
}

model EmployeeBankAccount {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  iban              String
  bankName          String?
  accountHolderName String?
  bicSwift          String?

  validFrom DateTime  @default(now())
  validTo   DateTime?

  isPrimary Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("employee_bank_accounts")
}

model EmployeeEmergencyContact {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  fullName     String
  relationship String
  phone        String
  email        String?
  notes        String? @db.Text

  isPrimary Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

// -----------------------------------------------------------------------------
// Kosovo-oriented payroll parameters (versioned, effective-dated)
// -----------------------------------------------------------------------------

/// Company-specific overrides layered on national defaults (national rows companyId = null optional — here scoped per company for simplicity & tenancy)
model PayrollParameterSet {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  effectiveFrom DateTime // inclusive; find active set where effectiveFrom <= anchor date
  effectiveTo   DateTime? // exclusive upper bound; null = open-ended

  label String?

  /// Kosovo legal minimum monthly wage at time of validity (validate Employee.baseSalaryMonthly against this when EmploymentType = EMPLOYEE)
  minimumMonthlyWage Decimal @db.Decimal(14, 2)

  /// Rates as decimal fractions: e.g. 0.05 = 5%
  pensionEmployeeRate Decimal @db.Decimal(8, 6)
  pensionEmployerRate Decimal @db.Decimal(8, 6)

  /// Overtime/holiday/weekend multipliers (structure consumed by payroll calculation engine)
  premiumRules Json?

  /// Defaults: null → engine uses legislation snapshot default (10% for SECONDARY employer)
  secondaryEmployerFlatRate Decimal? @db.Decimal(8, 6)

  secondaryEmployerPitBase SecondaryEmployerPitBase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pitBrackets PitBracket[]
  payrolls    Payroll[]

  @@index([companyId, effectiveFrom])
  @@index([companyId, effectiveTo])
  @@map("payroll_parameter_sets")
}

/// Progressive / bracket PIT model — Kosovo-aligned shape (bands maintained administratively)
model PitBracket {
  id String @id @default(cuid())

  parameterSetId String
  parameterSet   PayrollParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Cascade)

  /// Lower bound inclusive (same currency as payroll — EUR)
  fromAmount Decimal @db.Decimal(14, 2)
  /// Upper bound inclusive; use very large upper for top bracket
  toAmount   Decimal @db.Decimal(14, 2)
  /// Marginal rate for this band as decimal fraction
  rate       Decimal @db.Decimal(8, 6)
  /// Flat deductible / allowance per band optional (extend later)
  sequence   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parameterSetId])
  @@map("pit_brackets")
}

// -----------------------------------------------------------------------------
// Monthly payroll shell & entries (locking)
// -----------------------------------------------------------------------------

model Payroll {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Calendar month payroll identifier (Kosovo monthly cycles)
  year  Int
  month Int // 1-12

  currency CurrencyCode @default(EUR)

  status PayrollPeriodStatus @default(DRAFT)

  /// Weekdays Mon–Fri in month × 8h baseline (full-time); set when spreadsheet generated.
  expectedWorkingDays    Int?
  expectedRegularHours   Decimal? @db.Decimal(10, 2)

  validatedAt       DateTime?
  validationWarnings Json?

  parameterSetId String?
  parameterSet   PayrollParameterSet? @relation(fields: [parameterSetId], references: [id], onDelete: SetNull)

  /// Who prepared this payroll — printed as PËRGATITI on the sign-off sheet.
  createdById String?
  createdBy   User?    @relation("PayrollCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lockedAt DateTime?
  lockedById String?
  lockedBy   User?    @relation("PayrollLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  reviewedById String?
  reviewedBy   User?    @relation("PayrollReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?
  approvedById String?
  approvedBy   User?    @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  archivedById String?
  archivedBy   User?    @relation("PayrollArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries PayrollEntry[]
  snapshot PayrollSnapshot?
  generatedDocuments PayrollGeneratedDocument[]
  includedEmployees PayrollIncludedEmployee[]
  corrections PayrollCorrection[]
  documentGenerationArtifacts DocumentGenerationArtifact[]
  atkExports    PayrollATKExport[]
  terminationsFinalPayroll Termination[] @relation("TerminationFinalPayroll")

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@index([companyId, year, month])
  @@index([status])
  @@map("payrolls")
}

/// A parallel, deliberately simpler payroll for hourly-paid contractors (gross-out: no
/// PIT, no pension — those are forced off for CONTRACTOR employees by construction).
/// Separate from Payroll so the regular monthly cycle keeps its one-period-per-month
/// constraint and its ATK/Libri i Pagave surface untouched.
model ContractorPayrollPeriod {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year  Int
  month Int // 1-12

  status ContractorPayrollStatus @default(DRAFT)

  createdById String?
  createdBy   User?   @relation("ContractorPayrollCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lockedAt   DateTime?
  lockedById String?
  lockedBy   User?     @relation("ContractorPayrollLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries ContractorPayrollEntry[]

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@map("contractor_payroll_periods")
}

model ContractorPayrollEntry {
  id String @id @default(cuid())

  periodId String
  period   ContractorPayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Frozen from the employee when the entry is (re)generated. Which one is
  /// actually paid depends on payBasis; the other is kept for the audit trail.
  hourlyRateSnapshot Decimal @db.Decimal(14, 4)

  /// Frozen from Employee.compensationBasis — a contractor switched mid-year
  /// must not retroactively change how a locked period was paid.
  payBasis ContractorPayBasis @default(HOURLY)

  /// The month's agreed fee when payBasis = MONTHLY_FLAT. Editable per period so
  /// a partial month (started late, left early) can be pro-rated by hand.
  monthlyFlatAmount Decimal @default(0) @db.Decimal(14, 2)

  /// True once HR has edited the flat amount ON THIS PERIOD. Regeneration and
  /// profile-salary sync overwrite the amount only while this is false — a
  /// hand-entered pro-rata must survive a roster refresh, but a stale creation
  /// snapshot must not block a salary change from the profile.
  flatAmountManuallySet Boolean @default(false)

  regularHours  Decimal @default(0) @db.Decimal(10, 2)
  overtimeHours Decimal @default(0) @db.Decimal(10, 2)
  weekendHours  Decimal @default(0) @db.Decimal(10, 2)
  holidayHours  Decimal @default(0) @db.Decimal(10, 2)
  nightHours    Decimal @default(0) @db.Decimal(10, 2)

  /// Provenance only — TIMECLOCK means the buckets were pre-filled from aggregated
  /// time-clock days; every field stays hand-editable either way.
  hoursSource ContractorHoursSource @default(MANUAL)

  /// Final figure — net = gross, contractors carry no withholding here.
  grossPay Decimal @default(0) @db.Decimal(14, 2)

  calculationBreakdown Json?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@map("contractor_payroll_entries")
}

model PayrollIncludedEmployee {
  payrollId String
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([payrollId, employeeId])
  @@index([employeeId])
  @@map("payroll_included_employees")
}

model PayrollCorrection {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  payrollId String
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  kind PayrollCorrectionKind

  amount Decimal @db.Decimal(14, 2)

  reason String @db.Text

  createdByUserId String?
  createdBy       User?   @relation("PayrollCorrectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([companyId, payrollId])
  @@index([payrollId, employeeId])
  @@map("payroll_corrections")
}

model PayrollEntry {
  id String @id @default(cuid())

  payrollId String
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  status PayrollEntryStatus @default(DRAFT)

  /// Frozen classification for audit trail — contractors must have zero withheld fields by application rule
  employmentTypeSnapshot EmploymentType

  employerPrimacySnapshot EmployerPrimacy @default(PRIMARY)

  calendarDaysInMonth Int
  paidDays            Decimal @db.Decimal(6, 2)

  jobTitleSnapshot String?

  compensationBasisSnapshot CompensationBasis?

  contractGrossMonthlySnapshot Decimal? @db.Decimal(14, 2)
  contractNetMonthlySnapshot   Decimal? @db.Decimal(14, 2)

  expectedWorkingDays    Int?
  expectedRegularHours   Decimal? @db.Decimal(10, 2)
  actualRegularHours     Decimal @default(0) @db.Decimal(10, 2)

  paidLeaveHours   Decimal @default(0) @db.Decimal(10, 2)
  sickLeaveHours   Decimal @default(0) @db.Decimal(10, 2)
  unpaidLeaveHours Decimal @default(0) @db.Decimal(10, 2)

  /// Premium hours / amounts (frozen at calculation time)
  overtimeHours   Decimal @default(0) @db.Decimal(10, 2)
  overtimeAmount  Decimal @default(0) @db.Decimal(14, 2)
  holidayHours    Decimal @default(0) @db.Decimal(10, 2)
  holidayAmount   Decimal @default(0) @db.Decimal(14, 2)
  weekendHours    Decimal @default(0) @db.Decimal(10, 2)
  weekendAmount   Decimal @default(0) @db.Decimal(14, 2)
  nightHours      Decimal @default(0) @db.Decimal(10, 2)
  nightAmount     Decimal @default(0) @db.Decimal(14, 2)
  /// Hours whose base pay already sits in a higher premium bucket but which also qualify
  /// for this one. They earn the uplift only — multiplier − 1 — so a Sunday 23:00 hour pays
  /// 1.8× (weekend base + night uplift) rather than 2.8×.
  nightStackHours    Decimal @default(0) @db.Decimal(10, 2)
  overtimeStackHours Decimal @default(0) @db.Decimal(10, 2)

  hourlyRate Decimal @default(0) @db.Decimal(14, 6)

  regularPay           Decimal @default(0) @db.Decimal(14, 2)
  paidLeavePay         Decimal @default(0) @db.Decimal(14, 2)
  sickLeavePay         Decimal @default(0) @db.Decimal(14, 2)
  unpaidLeaveDeduction Decimal @default(0) @db.Decimal(14, 2)

  /// Bonuses increase taxable gross after premium stack (engine applies before statutory contributions).
  bonuses Decimal @default(0) @db.Decimal(14, 2)

  /// Parapaguesë / zbritje të tjera (jo parapaguesë e veçantë)
  otherDeductions Decimal @default(0) @db.Decimal(14, 2)

  salaryAdvanceDeduction Decimal @default(0) @db.Decimal(14, 2)

  manualGrossOverride Decimal? @db.Decimal(14, 2)
  manualNetOverride   Decimal? @db.Decimal(14, 2)
  manualGrossReason   String?
  manualNetReason     String?

  notes String? @db.Text

  grossSalary           Decimal @db.Decimal(14, 2)
  taxableIncome         Decimal @db.Decimal(14, 2)
  pitWithheld           Decimal @db.Decimal(14, 2)
  pensionEmployee       Decimal @db.Decimal(14, 2)
  pensionEmployer       Decimal @db.Decimal(14, 2)
  otherEmployerCosts    Decimal @default(0) @db.Decimal(14, 2)
  netPay                Decimal @db.Decimal(14, 2)

  employerTotalCost Decimal @default(0) @db.Decimal(14, 2)

  /// Calculation audit payload (brackets applied, rounding policy version, leave splits, etc.)
  calculationBreakdown Json?

  isLocked Boolean @default(false)

  payslipDeliveryStatus PayslipDeliveryStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjustments PayrollAdjustment[]

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@index([payrollId])
  @@map("payroll_entries")
}

/// Company-scoped payroll operation parameters (loaded by engine — never hardcoded in UI).
model PayrollSettings {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  minimumSalaryMonthly Decimal @db.Decimal(14, 2)

  /// Planned minimum (e.g. €500 from July) — engine picks by anchor date vs minimumSalaryScheduledEffectiveFrom
  minimumSalaryScheduledAmount Decimal? @db.Decimal(14, 2)

  minimumSalaryScheduledEffectiveFrom DateTime?

  pensionEmployeePercent Decimal @db.Decimal(8, 6)
  pensionEmployerPercent Decimal @db.Decimal(8, 6)

  overtimeMultiplier Decimal @default(1.3) @db.Decimal(8, 4)
  weekendMultiplier  Decimal @default(1.5) @db.Decimal(8, 4)
  /// Festë — +50% si fundjava (Ligji i Punës i Kosovës)
  holidayMultiplier  Decimal @default(1.5) @db.Decimal(8, 4)

  /// Premium për punë natën — nga PayrollSettings (motor + transparency)
  nightWorkMultiplier Decimal @default(1.3) @db.Decimal(8, 4)

  /// Orë për ditë pune standarde (full-time default 8) — `expected_hours = working_days × hoursPerWorkingDay`
  hoursPerWorkingDay Decimal @default(8) @db.Decimal(6, 2)

  /// Normë javore për përshkrimin e overtime (transparency / politikë — default 40h)
  overtimeWeeklyThresholdHours Decimal @default(40) @db.Decimal(6, 2)

  /// Paga e sëmurë si përqindje e normës (1 = 100 %). Neni 60 i Ligjit të Punës kërkon
  /// 100% — vlerat nën 1 ngrihen automatikisht në dysheme statutore nga motori
  /// (statutorySickLeavePayPercent); mbi 1 lejohet (punëdhënës më bujar).
  sickLeavePayPercent Decimal @default(1) @db.Decimal(8, 6)

  /// Oret maksimum javore të overtime për sinjal paralajmërimi (default 8 sipas kontekstit ligjor)
  overtimeWeeklyCapHours Decimal @default(8) @db.Decimal(8, 2)

  standardWeeklyHours Decimal @db.Decimal(6, 2)

  /// Lista opsionale ISO `YYYY-MM-DD` për festa shtesë (per kompani / përditësime ligjore)
  payrollExtraHolidayDates Json?

  /// ISO `YYYY-MM-DD` që nuk trajtohen si festë zyrtare edhe nëse bien në kalendarin bazë
  payrollExcludedHolidayDates Json?

  /// Për transparency HR (default dritare tipike natë)
  nightWorkPeriodDescription String @default("22:00–06:00") @db.VarChar(96)

  /// Dritarja e natës si orë reale (0–23) që klasifikuesi i orës së punës mund t'i lexojë —
  /// nightWorkPeriodDescription mbetet vetëm tekst shpjegues. Dritarja kalon mesnatën
  /// kur nightStartHour > nightEndHour (p.sh. 22 → 6).
  nightStartHour Int @default(22)
  nightEndHour   Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payroll_settings")
}

/// Company-scoped yearly holiday calendar — drives expected working-day / regular-hour baselines.
model CompanyHoliday {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Calendar year this configuration row belongs to (e.g. payroll year 2026).
  calendarYear Int

  /// Observed public holiday date (date-only semantics in UTC).
  observedOn DateTime @db.Date

  name String

  category CompanyHolidayCategory

  /// When false, the date is ignored for capacity / expected-hours calculations (still stored for audit).
  isActive Boolean @default(true)

